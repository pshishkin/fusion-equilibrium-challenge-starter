# Copy to .env and fill in. The Makefile includes .env and exports it; .env is gitignored.
#
# A fine-grained Hugging Face token with READ access to your predictions repo and nothing else: it
# ends up inside the pointer zip that Codabench downloads, which is why it must be read-only.
HF_READ_TOKEN=hf_...

# Optional, downloads only. Without it `make download_dataset` warns "You are sending
# unauthenticated requests to the HF Hub" and runs on the anonymous rate limit. The dataset is
# public, so this buys throughput and headroom, not access. It never leaves the machine, so it does
# not have to be the read-only one above.
HF_TOKEN=hf_...
