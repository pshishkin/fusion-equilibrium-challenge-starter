    "script_source": "\"\"\"Measure warm full-frame loading for the completed compact campaign.\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport sys\nimport time\nfrom pathlib import Path\n\nROOT = Path('/home/pavel/fusion-equilibrium-challenge-starter')\nCAMPAIGN = ROOT / 'runs/compact-production-9301af36275620f7'\nsys.path.insert(0, str(CAMPAIGN / 'source'))\nos.environ['FUSION_SHOT_CACHE'] = str(ROOT / '.shot_cache')\nos.environ['FUSION_AUX_CACHE'] = str(ROOT / '.aux_targets')\n\nfrom my_experiments import aux_targets\nfrom my_experiments.baseline_model import _read_shots, sorted_shots, split_train_val\nfrom toolkit.parallel import release\n\n\ndef main() -> None:\n    files = sorted_shots(Path('/home/pavel/downloaded_huggingface/hf_dataset'), 'diii_d_train', 0)\n    train, val = split_train_val(files, 0.80, 0.19)\n    started = time.perf_counter()\n    aux_targets.ensure([('train', train), ('validation', val)], 24)\n    aux_s = time.perf_counter() - started\n    begin = time.perf_counter()\n    arrays = _read_shots(train, 'warm train', 1.0, 24)\n    train_s = time.perf_counter() - begin\n    begin = time.perf_counter()\n    val_arrays = _read_shots(val, 'warm validation', 1.0, 24)\n    val_s = time.perf_counter() - begin\n    result = {'campaign': str(CAMPAIGN.relative_to(ROOT)), 'jobs': 24,\n              'auxiliary_cache_check_seconds': aux_s, 'train_read_seconds': train_s,\n              'validation_read_seconds': val_s, 'train_frames': len(arrays[0]),\n              'validation_frames': len(val_arrays[0]), 'kind': 'warm read only; no model fitting'}\n    release()\n    (ROOT / 'logs/compact-warm-read.json').write_text(json.dumps(result, indent=2) + '\\n')\n    print(json.dumps(result, indent=2))\n\n\nif __name__ == '__main__':\n    main()\n",
